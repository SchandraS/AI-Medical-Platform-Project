server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy API calls to the backend service. BACKEND_SCHEME/BACKEND_HOST/
    # BACKEND_PORT are substituted by docker-entrypoint.sh at container
    # start (envsubst, scoped to only these three variables so nginx's own
    # $host/$remote_addr/etc. below are left alone) -- defaults below match
    # docker-compose's plain-HTTP service name/port so a plain `docker
    # build` with no env vars set still produces a config identical to the
    # pre-Render static file. On Render, render.yaml sets BACKEND_SCHEME to
    # "http" too: fromService/property:host+port there give the backend's
    # *private-network* address, which is plain HTTP on Render's internal
    # network (TLS is only terminated at Render's public edge, not between
    # a project's own services) -- BACKEND_SCHEME stays a variable rather
    # than hardcoded http:// so an https:// backend (e.g. one reached over
    # the public internet instead of Render's private network) still works;
    # proxy_ssl_server_name only takes effect when the scheme is https.
    # Large batch CSV uploads need a bumped body size.
    # Temporary unambiguous diagnostic route: returns a fixed, unmistakable
    # plain-text body directly from nginx itself, no proxy_pass involved at
    # all. If this doesn't return exactly "NGINX_API_LOCATION_REACHED",
    # location /api/ (in any form) is not being reached for this path,
    # full stop -- rules out every proxy_pass/backend-connectivity
    # hypothesis at once.
    location = /api/__routing_probe__ {
        add_header X-Matched-Location "api-proxy-probe" always;
        default_type text/plain;
        return 200 "NGINX_API_LOCATION_REACHED";
    }

    # Second diagnostic probe: proxies to a known-good, always-reachable
    # external HTTPS site (not our backend) to isolate whether proxy_pass
    # itself works at all from inside Render's container network, separate
    # from any question about reaching manas-backend specifically.
    location = /api/__proxy_probe__ {
        add_header X-Matched-Location "proxy-probe" always;
        proxy_pass https://example.com/;
        proxy_ssl_server_name on;
        proxy_set_header Host example.com;
    }

    location /api/ {
        # Temporary marker header while diagnosing a live routing
        # discrepancy: proves definitively (via a response header alone,
        # no shell access needed) whether a given request was served by
        # THIS location block or fell through to location / below.
        add_header X-Matched-Location "api-proxy" always;
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}:${BACKEND_PORT}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 20m;
        proxy_read_timeout 120s;
    }

    # Single-page app: any non-file route falls back to index.html so
    # client-side routing (react-router) works on a hard refresh.
    location / {
        add_header X-Matched-Location "spa-fallback" always;
        try_files $uri $uri/ /index.html;
    }
}
