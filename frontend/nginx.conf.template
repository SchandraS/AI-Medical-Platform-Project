server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy API calls to the backend service. BACKEND_SCHEME/BACKEND_HOST/
    # BACKEND_PORT are substituted by docker-entrypoint.sh at container
    # start (envsubst, scoped to only these three variables so nginx's own
    # $host/$remote_addr/etc. below are left alone) -- defaults below match
    # docker-compose's plain-HTTP service name/port so a plain `docker
    # build` with no env vars set still produces a config identical to the
    # pre-Render static file. On Render, render.yaml sets BACKEND_SCHEME to
    # "http" too: fromService/property:host+port there give the backend's
    # *private-network* address, which is plain HTTP on Render's internal
    # network (TLS is only terminated at Render's public edge, not between
    # a project's own services) -- BACKEND_SCHEME stays a variable rather
    # than hardcoded http:// so an https:// backend (e.g. one reached over
    # the public internet instead of Render's private network) still works;
    # proxy_ssl_server_name only takes effect when the scheme is https.
    # Large batch CSV uploads need a bumped body size.
    location /api/ {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}:${BACKEND_PORT}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 20m;
        proxy_read_timeout 120s;
    }

    # Single-page app: any non-file route falls back to index.html so
    # client-side routing (react-router) works on a hard refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
