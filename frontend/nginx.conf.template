server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy API calls to the backend service. BACKEND_SCHEME/BACKEND_HOST/
    # BACKEND_PORT are substituted by docker-entrypoint.sh at container
    # start (envsubst, scoped to only these three variables so nginx's own
    # $host/$remote_addr/etc. below are left alone) -- defaults below match
    # docker-compose's plain-HTTP service name/port so a plain `docker
    # build` with no env vars set still produces a config identical to the
    # pre-Render static file. On Render, BACKEND_SCHEME is "https" (the
    # backend's public URL) -- see render.yaml for why it's the public URL
    # rather than Render's private network.
    # Large batch CSV uploads need a bumped body size.
    location /api/ {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}:${BACKEND_PORT}/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        # Host must be the BACKEND's own hostname, not the original
        # client's ($host here would be the frontend's own public
        # hostname). Render/Cloudflare's edge routes many services from
        # shared IPs using Host-header/SNI-based routing at the origin --
        # forwarding the *client's* Host instead of the backend's silently
        # misroutes the proxied request to whichever service that Host
        # actually belongs to (in production, this routed the request
        # right back to this same frontend container, which is why /api/*
        # appeared to silently fall through to the SPA's own static-file
        # handling -- confirmed by reproducing the exact symptom locally
        # only once an external Host header matching the real deployed
        # frontend hostname was sent, and confirmed fixed by explicitly
        # setting Host to the backend's own hostname here).
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 20m;
        proxy_read_timeout 120s;
    }

    # Single-page app: any non-file route falls back to index.html so
    # client-side routing (react-router) works on a hard refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
